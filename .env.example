# ===========================================
# Environment variables for Pet Rescue API
# Copy to .env and fill in real values. Never commit .env.
#
# Values below match the local docker-compose.yml services
# (postgres, redis, rabbitmq, mongo). Spring does not read .env by itself:
# docker compose substitutes it into the compose files; for ./gradlew bootRun
# export the variables or load the file with your IDE's env-file support.
# ===========================================

# ── Spring profile ───────────────────────────
# Default: free (512 MB container). Others: scale, production (NeonDB + cloud services).
# SPRING_PROFILES_ACTIVE=production

# ── Server (docker-compose.prod.yml host port) ──
# PORT=8080

# ── Database — PostgreSQL (local Docker) ─────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petrescue
DB_USERNAME=petrescue
DB_PASSWORD=petrescue

# ── Database — NeonDB (production profile, SSL is always on) ──
# DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=petrescue
# DB_USERNAME=petrescue_owner
# DB_PASSWORD=your-neondb-password

# ── MongoDB — chat + social posts (see migrate.md) ──
# Must be a replica set (transactions). Local: the `mongo` compose service (rs0).
# Production: e.g. MongoDB Atlas — mongodb+srv://user:password@cluster.xxxxx.mongodb.net/petrescue
MONGO_URI=mongodb://localhost:27017/petrescue?replicaSet=rs0&directConnection=true
# Include MongoDB in /actuator/health
MONGO_HEALTH_ENABLED=true

# ── Redis (local Docker; cloud Redis in production) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL_ENABLED=true

# ── RabbitMQ (local Docker; CloudAMQP in production) ──
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=petrescue
RABBITMQ_PASSWORD=petrescue
# RABBITMQ_VHOST=/
# RABBITMQ_SSL_ENABLED=true

# ── JWT / Security ───────────────────────────
# Required — the app does not start without it. Base64-encoded key of at least 256 bits:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
# Comma-separated origins allowed by CORS
APP_CORS_ALLOWED_ORIGINS=*

# ── Email / SMTP (verification + password reset emails) ──
# Use real SMTP host and credentials in production. For Gmail, enable App Passwords.
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace_with_real_password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true

# ── App email settings ───────────────────────
# Address emails are sent from (displayed in the From header)
EMAIL_FROM=noreply@petrescue.example
# Verification callback URL shown in emails
EMAIL_VERIFICATION_URL=http://localhost:8080/api/v1/auth/verify-email
# Frontend page that handles the reset token
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ── Cloudinary / media storage ───────────────
# Read by CloudinaryConfig and CloudinaryStorageAdapter.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional folder overrides used by upload flows
CLOUDINARY_TEMP_FOLDER=temp
CLOUDINARY_PERMANENT_FOLDER=pet-rescue

# ── AI post analysis ──
# Off by default: no Claude API calls, no cost.
AI_POST_ANALYSIS_ENABLED=false
# AI_POST_ANALYSIS_MODEL=claude-opus-5-5
# Claude API key (https://console.anthropic.com) — only needed when enabled
# ANTHROPIC_API_KEY=sk-ant-...

# ── Swagger UI (production profile only; always on locally) ──
# SPRINGDOC_SWAGGER_UI_ENABLED=false

# ── Docker image tag (used by docker-compose.prod.yml) ──
# IMAGE_TAG=ghcr.io/your-org/pet-rescue-api:latest
